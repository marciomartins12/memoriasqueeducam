<section class="tela-jogos tela-jogos-lista">
  <header class="moradores-cabecalho">
    <a href="/dashboard" class="btn-voltar" aria-label="Voltar ao dashboard">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
    </a>
    <h1 class="moradores-titulo">Jogos Educativos</h1>
  </header>

  <main class="jogos-lista">
    {{#each jogos}}
    <a href="/jogos/{{this.slug}}" class="jogo-card jogo-card-{{this.icone}}" data-jogo-slug="{{this.slug}}">
      <div class="jogo-card-esquerda">
        <span class="jogo-card-icone jogo-icone-{{this.icone}}" aria-hidden="true">
          {{#ifCond this.icone '==' 'caca-palavras'}}
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="52" height="52" rx="8" fill="#FAF0D7" stroke="#B66524" stroke-width="3"/>
            <path d="M16 18 L16 46 M26 18 L26 46 M36 18 L36 46 M46 18 L46 46" stroke="#C9833B" stroke-width="2" stroke-linecap="round"/>
            <path d="M14 26 L50 26 M14 36 L50 36" stroke="#C9833B" stroke-width="2" stroke-linecap="round"/>
            <circle cx="21" cy="21" r="2.4" fill="#7FA23E"/>
            <circle cx="31" cy="31" r="2.4" fill="#E8843C"/>
            <circle cx="41" cy="41" r="2.4" fill="#9C5A22"/>
            <path d="M18 44 L28 34" stroke="#5A7A2E" stroke-width="3.2" stroke-linecap="round"/>
            <path d="M36 22 L46 32" stroke="#5A7A2E" stroke-width="3.2" stroke-linecap="round"/>
          </svg>
          {{/ifCond}}
          {{#ifCond this.icone '==' 'verdadeiro-falso'}}
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="52" height="52" rx="8" fill="#FAF0D7" stroke="#6C4A8A" stroke-width="3"/>
            <path d="M14 16 L50 16 L50 48 L14 48 Z" fill="#FFFAEA" stroke="#D8B67A" stroke-width="2" rx="4"/>
            <path d="M14 24 L50 24" stroke="#D8B67A" stroke-width="2" stroke-linecap="round"/>
            <path d="M14 32 L50 32" stroke="#D8B67A" stroke-width="2" stroke-linecap="round"/>
            <path d="M14 40 L50 40" stroke="#D8B67A" stroke-width="2" stroke-linecap="round"/>
            <circle cx="22" cy="20" r="3" fill="#7FA23E"/>
            <path d="M19.5 20 L21.5 22 L25 18.5" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="44" cy="28" r="3" fill="#C64A3E"/>
            <path d="M42.2 26.2 L45.8 29.8 M45.8 26.2 L42.2 29.8" stroke="white" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="22" cy="36" r="3" fill="#7FA23E"/>
            <path d="M19.5 36 L21.5 38 L25 34.5" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="44" cy="44" r="3" fill="#C64A3E"/>
            <path d="M42.2 42.2 L45.8 45.8 M45.8 42.2 L42.2 45.8" stroke="white" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          {{/ifCond}}
          {{#ifCond this.icone '==' 'quiz'}}
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="52" height="52" rx="8" fill="#FAF0D7" stroke="#E8843C" stroke-width="3"/>
            <rect x="14" y="14" width="36" height="36" rx="6" fill="#FFFAEA" stroke="#D8B67A" stroke-width="2"/>
            <circle cx="32" cy="28" r="8" fill="#E8843C"/>
            <path d="M32 22 C35 22 37.5 24 37.5 27 C37.5 30 34.5 31 33 32.5 C31.5 34 31.5 35 31.5 36" stroke="white" stroke-width="2.2" stroke-linecap="round" fill="none"/>
            <circle cx="32" cy="40.5" r="1.8" fill="white"/>
          </svg>
          {{/ifCond}}
        </span>
        <div class="jogo-card-info">
          <span class="jogo-card-numero">Jogo {{this.numero}}</span>
          <span class="jogo-card-nome">{{this.nome}}</span>
          <span class="jogo-card-desc">{{this.descricao}}</span>
        </div>
      </div>
      <div class="jogo-card-direita">
        <svg viewBox="0 0 24 24" class="saberes-seta" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </div>
    </a>
    {{/each}}
  </main>
</section>
