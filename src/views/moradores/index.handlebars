<script>
(function () {
  'use strict';
  try {
    var scriptDados = document.getElementById('moradoresDados');
    var moradores = scriptDados ? JSON.parse(scriptDados.textContent) : [];
    if (!moradores || !moradores.length) return;

    var modal = document.getElementById('moradorModal');
    var overlay = modal.querySelector('[data-morador-modal-fechar]');
    var fecharBtn = modal.querySelector('.morador-modal-fechar');
    var fotoEl = document.getElementById('moradorModalFoto');
    var tituloEl = document.getElementById('moradorModalTitulo');
    var idadeEl = document.getElementById('moradorModalIdade');
    var localEl = document.getElementById('moradorModalLocalidade');
    var corpoEl = document.getElementById('moradorModalCorpo');
    var ultimoFoco = null;

    function escaparHtml(str) {
      if (str == null) return '';
      return String(str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function quebrarParagrafos(texto) {
      if (!texto) return '';
      var partes = String(texto).split(/\r?\n{2,}|\r?\n/);
      var html = '';
      for (var i = 0; i < partes.length; i++) {
        var p = partes[i].trim();
        if (p) html += '<p>' + escaparHtml(p) + '</p>';
      }
      return html || '<p>' + escaparHtml(String(texto)) + '</p>';
    }

    function abrirModal(m) {
      ultimoFoco = document.activeElement;
      fotoEl.src = m.foto || '';
      fotoEl.alt = 'Foto de ' + (m.nome || 'Morador');
      tituloEl.textContent = m.nome + (m.apelido ? ' (' + m.apelido + ')' : '');
      idadeEl.textContent = m.idade || '';
      localEl.textContent = m.localidade || '';
      corpoEl.innerHTML = quebrarParagrafos(m.relato || '');
      modal.classList.add('saberes-modal-aberto');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setTimeout(function () { try { fecharBtn.focus(); } catch (e) {} }, 30);
    }

    function fecharModal() {
      modal.classList.remove('saberes-modal-aberto');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (ultimoFoco && typeof ultimoFoco.focus === 'function') try { ultimoFoco.focus(); } catch (e) {}
    }

    fecharBtn.addEventListener('click', fecharModal);
    overlay.addEventListener('click', fecharModal);
    modal.addEventListener('click', function (e) { if (e.target === modal) fecharModal(); });
    document.addEventListener('keydown', function (e) {
      if (!modal.classList.contains('saberes-modal-aberto')) return;
      if (e.key === 'Escape') { e.preventDefault(); fecharModal(); }
    });

    var pins = document.querySelectorAll('[data-morador-id]');
    for (var i = 0; i < pins.length; i++) {
      (function (btn) {
        btn.addEventListener('click', function () {
          var id = parseInt(btn.getAttribute('data-morador-id'), 10);
          var m = null;
          for (var j = 0; j < moradores.length; j++) {
            if (Number(moradores[j].id) === id) { m = moradores[j]; break; }
          }
          if (m) abrirModal(m);
        });
      })(pins[i]);
    }
  } catch (e) {}
})();
</script>
