<section class="tela-sobre">
  <header class="sobre-cabecalho">
    <a href="/dashboard" class="btn-voltar" aria-label="Voltar para o menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
    </a>
    <h1 class="sobre-titulo">Sobre o Site</h1>
  </header>

  <main class="sobre-conteudo" role="main">
    <!-- CARD INTRODUÇÃO -->
    <article class="sobre-card sobre-card-intro" aria-labelledby="sobreIntroTitulo">
      <span class="sobre-tag">Projeto Acadêmico</span>
      <h2 id="sobreIntroTitulo" class="sobre-intro-titulo">Prática Curricular na Dimensão Escolar</h2>
      <p class="sobre-intro-texto">
        Desenvolvida como atividade de prática curricular em licenciatura, esta plataforma registra e
        difunde a memória coletiva e os saberes tradicionais das comunidades quilombolas de
        São Felipe e Santa Rita, em Presidente Sarney – Maranhão.
      </p>
    </article>

    <!-- SEÇÃO ESTUDANTES -->
    <section class="sobre-secao" aria-labelledby="alunosTitulo">
      <header class="sobre-secao-cabecalho">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <h2 id="alunosTitulo" class="sobre-secao-titulo">Estudantes Autores</h2>
      </header>

      <div class="sobre-grid-alunos">
        <div class="sobre-cartao-aluno">
          <div class="sobre-aluno-avatar" aria-label="Foto de Antonia Ingredy">
            <img src="/img/sobreOSite/Antonia.jpeg" alt="Foto de Antonia Ingredy Ribeiro Almeida Borges" loading="lazy" onerror="this.parentElement.classList.add('sobre-aluno-avatar--fallback');">
          </div>
          <p class="sobre-aluno-nome">Antonia Ingredy Ribeiro Almeida Borges</p>
        </div>

        <div class="sobre-cartao-aluno">
          <div class="sobre-aluno-avatar" aria-label="Foto de Diego Rafael">
            <img src="/img/sobreOSite/DIEGO.jpeg" alt="Foto de Diego Rafael Araujo Fernandes" loading="lazy" onerror="this.parentElement.classList.add('sobre-aluno-avatar--fallback');">
          </div>
          <p class="sobre-aluno-nome">Diego Rafael Araujo Fernandes</p>
        </div>

        <div class="sobre-cartao-aluno">
          <div class="sobre-aluno-avatar" aria-label="Foto de Letícia Thaynara">
            <img src="/img/sobreOSite/Letícia.jpeg" alt="Foto de Leticia Thaynara Pinheiro Martins Fernandes" loading="lazy" onerror="this.parentElement.classList.add('sobre-aluno-avatar--fallback');">
          </div>
          <p class="sobre-aluno-nome">Leticia Thaynara Pinheiro Martins Fernandes</p>
        </div>

        <div class="sobre-cartao-aluno">
          <div class="sobre-aluno-avatar" aria-label="Foto de Luciana Araujo">
            <img src="/img/sobreOSite/Luciana.jpeg" alt="Foto de Luciana Araujo Davila" loading="lazy" onerror="this.parentElement.classList.add('sobre-aluno-avatar--fallback');">
          </div>
          <p class="sobre-aluno-nome">Luciana Araujo Davila</p>
        </div>

        <div class="sobre-cartao-aluno">
          <div class="sobre-aluno-avatar" aria-label="Foto de Michael Douglas">
            <img src="/img/sobreOSite/MICHAEL.jpeg" alt="Foto de Michael Douglas Souza Martins" loading="lazy" onerror="this.parentElement.classList.add('sobre-aluno-avatar--fallback');">
          </div>
          <p class="sobre-aluno-nome">Michael Douglas Souza Martins</p>
        </div>

        <div class="sobre-cartao-aluno">
          <div class="sobre-aluno-avatar" aria-label="Foto de Ronielly de Fatima">
            <img src="/img/sobreOSite/Ingrid.jpeg" alt="Foto de Ronielly de Fatima Pereira Davila" loading="lazy" onerror="this.parentElement.classList.add('sobre-aluno-avatar--fallback');">
          </div>
          <p class="sobre-aluno-nome">Ronielly de Fatima Pereira Davila</p>
        </div>
      </div>
    </section>

    <!-- SEÇÃO INSTITUIÇÃO -->
    <section class="sobre-secao" aria-labelledby="instituicaoTitulo">
      <header class="sobre-secao-cabecalho sobre-secao-cabecalho-mostarda">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
          <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
        </svg>
        <h2 id="instituicaoTitulo" class="sobre-secao-titulo">Curso e Instituição</h2>
      </header>

      <article class="sobre-card sobre-card-instituicao">
        <ul class="sobre-lista-info" aria-label="Dados do curso">
          <li>
            <div class="sobre-info-icone sobre-info-icone-verde" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
            </div>
            <div class="sobre-info-texto">
              <span class="sobre-info-label">Período</span>
              <span class="sobre-info-valor">5° período do curso de graduação</span>
            </div>
          </li>
          <li>
            <div class="sobre-info-icone sobre-info-icone-laranja" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
            </div>
            <div class="sobre-info-texto">
              <span class="sobre-info-label">Curso</span>
              <span class="sobre-info-valor">Licenciatura em História</span>
            </div>
          </li>
          <li>
            <div class="sobre-info-icone sobre-info-icone-azul" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                <path d="M2 17l10 5 10-5"></path>
                <path d="M2 12l10 5 10-5"></path>
              </svg>
            </div>
            <div class="sobre-info-texto">
              <span class="sobre-info-label">Universidade</span>
              <span class="sobre-info-valor">Universidade Estadual do Maranhão (UEMA)</span>
            </div>
          </li>
        </ul>
      </article>
    </section>

    <!-- SEÇÃO PROFESSORA -->
    <section class="sobre-secao" aria-labelledby="professorTitulo">
      <header class="sobre-secao-cabecalho sobre-secao-cabecalho-verde">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z"></path>
          <path d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2z" style="display:none"></path>
        </svg>
        <h2 id="professorTitulo" class="sobre-secao-titulo">Professora Orientadora</h2>
      </header>

      <article class="sobre-card sobre-card-professor">
        <div class="sobre-professor-foto" aria-label="Foto da Professora Adriana">
          <img src="/img/sobreOSite/Professora Adriana.jpeg" alt="Foto da Profª Ma Adriana Dourado Oliveira" loading="lazy" onerror="this.parentElement.classList.add('sobre-professor-foto--fallback');">
        </div>
        <div class="sobre-professor-info">
          <span class="sobre-professor-titulo">Docente responsável</span>
          <h3 class="sobre-professor-nome">Prof. Ma Adriana Dourado Oliveira</h3>
          <span class="sobre-professor-rotulo">Ministrante da disciplina de Prática Curricular na Dimensão Escolar</span>
        </div>
      </article>
    </section>

    <!-- SEÇÃO LOCAL E DATA -->
    <section class="sobre-rodape-cartao" aria-label="Local e ano de realização do projeto">
      <div class="sobre-rodape-linha">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>Presidente Sarney – Maranhão</span>
      </div>
      <div class="sobre-rodape-divisoria" aria-hidden="true"></div>
      <div class="sobre-rodape-linha">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>Ano de 2026</span>
      </div>
    </section>
  </main>
</section>
